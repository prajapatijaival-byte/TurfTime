# TurfTime — Supabase Environment Configuration Template
# Copy this file to .env.local and populate with your Supabase project credentials.

# 1. Supabase Project URL
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Publishable / Anon Key
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here

# 3. Optional: Supabase Service Role Key (Server-side only, NEVER expose to client)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "service_role"
# Only needed if executing elevated admin operations without RLS restrictions.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
